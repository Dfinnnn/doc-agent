# Copy this file to .env and fill in the values. Never commit .env.

# LLM (Part 5) - any OpenAI-compatible provider
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Google Sheets (Part 1) - path to the service-account key file
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json

# Company Worksheet - ID of the TESTING Sheet copy during development
SHEET_ID=

# University Logbook - path to the (Testing) .docx during development
LOGBOOK_PATH=
