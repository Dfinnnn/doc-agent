# Copy this file to .env and fill in the values. Never commit .env.

# LLM (Part 5) - any OpenAI-compatible provider
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Google Sheets (Part 1) - path to the service-account key file, used by both modes.
# If the real Sheet belongs to another Google account, give each mode its own key:
#   TEST_GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
#   REAL_GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account-real.json
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json

# Which documents to use: "no" = the testing copies (default), "yes" = the real files.
# Only you change this. Run "python -m app.preflight" after changing it.
USE_REAL_FILES=no

# Testing copies (used while USE_REAL_FILES=no)
#   Sheet: the ID or the full link of the testing Sheet copy
#   Logbook: path to the (Testing) .docx - its file name must contain "Testing"
TEST_SHEET_ID=
TEST_LOGBOOK_PATH=

# Real files (used only when USE_REAL_FILES=yes; must differ from the testing ones)
#   Back up the real .docx first, and share the real Sheet with the
#   service-account email as Editor.
REAL_SHEET_ID=
REAL_LOGBOOK_PATH=
